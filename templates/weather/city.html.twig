{% extends 'base.html.twig' %}

{% block title %}
    Weather in {{ location.city }}, {{ location.country }}
{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        {% if measurements is empty %}
            <p>No measurements found for this location.</p>
        {% else %}
            <ul>
                {% for measurement in measurements %}
                    <li>
                        {{ measurement.date|date('d.m.Y') }}:
                        {{ measurement.temperature }}&deg;C :
                        {{ measurement.pressure }} hPa :
                        {{ measurement.humidity }}% :
                        {{ measurement.weatherCondition }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}

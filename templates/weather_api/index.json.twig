{% autoescape false %}
{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d') }}",
            "celsius": {{ m.temperature }},
            "fahrenheit": {{ m.fahrenheit }},
            "humidity": {{ m.humidity }},
            "pressure": {{ m.pressure }},
            "weatherCondition": "{{ m.weatherCondition }}"
        }{{ loop.last ? '' : ',' }}
        {% endfor %}
    ]
}
{% endautoescape %}
